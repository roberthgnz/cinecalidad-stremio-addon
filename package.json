{
  "name": "cinecalidad-stremio-addon",
  "version": "1.0.0",
  "description": "A Stremio addon for streaming movies from Cinecalidad, running on Cloudflare Workers.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cf:tail": "wrangler tail",
    "test": "jest --verbose \"--runInBand\" \"--detectOpenHandles\" \"--forceExit\"",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:meta": "node tests/test-meta-handler.js",
    "lint": "eslint src/ tests/ lib/ config/ --fix",
    "lint:check": "eslint src/ tests/ lib/ config/",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "validate": "pnpm run lint:check && pnpm run test",
    "precommit": "pnpm run validate",
    "docker:build": "docker build -t cinecalidad-addon .",
    "docker:run": "docker run -p 7000:7000 cinecalidad-addon",
    "docker:build-multi": "docker buildx build --platform linux/amd64,linux/arm64 -t cinecalidad-addon .",
    "docker:compose:up": "docker-compose up -d",
    "docker:compose:down": "docker-compose down",
    "docker:compose:logs": "docker-compose logs -f",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "keywords": [
    "stremio",
    "addon",
    "local-files",
    "streaming",
    "cloudflare-workers"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "express": "^5.1.0",
    "magnet-uri": "6.2.0",
    "parse-torrent-title": "^1.4.0",
    "stremio-addon-sdk": "^1.6.10"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^53.0.1",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3",
    "wrangler": "4.156.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "lib/**/*.js",
      "!src/**/*.test.js",
      "!**/__tests__/**"
    ],
    "coverageReporters": [
      "text",
      "html"
    ],
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ],
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.wrangler/"
    ]
  }
}
